# Server
PORT=3100
HOST=0.0.0.0

# Browser
MAX_TEXT_LENGTH=30000
DEFAULT_TIMEOUT=15000

# Rate limiting
RATE_LIMIT_RPM=60

# Search — multiple providers with automatic failover (any missing provider
# just drops out of the chain). Get keys at serper.dev, brave.com/search/api,
# socialcrawl.dev, apify.com
SERPER_API_KEY=
BRAVE_API_KEY=
SOCIALCRAWL_API_KEY=
# Facebook public post search (apify.com — console.apify.com → Integrations → API tokens)
APIFY_API_TOKEN=
# Screenshot capacity guards. The box is shared with other apps, and sustained
# capture throughput is ~32GB/day at average image size — enough to fill the
# volume before anything expires. Captures are refused with 507 past any limit.
# SCREENSHOT_MIN_FREE_GB=5      # refuse when the volume has less free than this
# SCREENSHOT_MAX_TOTAL_GB=10    # cap on all retained screenshots
# SCREENSHOT_MAX_CALLER_MB=1024 # per-caller cap
# SCREENSHOT_CONCURRENCY=3      # simultaneous captures (each holds a Chromium context)

# Reddit screenshot capture — reddit.com 403s this server's IP on every
# surface, so /screenshot routes Reddit URLs through an Apify post scraper.
# APIFY_REDDIT_ACTOR=trudax~reddit-scraper-lite

# Optional: override individual search actors
# APIFY_FB_SEARCH_ACTOR=
# APIFY_IG_SEARCH_ACTOR=
# APIFY_TT_SEARCH_ACTOR=
# APIFY_LI_SEARCH_ACTOR=

# /search/news source filter — extra hosts to treat as non-news, on top of the
# built-in blocklist (app stores, support/FAQ pages, retailers, job boards,
# wikis, social platforms). Comma-separated; subdomains are covered too.
# NEWS_BLOCKED_HOSTS=prnewswire.com,businesswire.com

# Sister apps (comma-separated) — these API keys bypass payment entirely.
# Use `name:key` entries to label apps on the /adm dashboard.
SISTER_API_KEYS=

# Admin dashboard at /adm (Basic auth) — per-app usage & cost analytics
ADMIN_USER=
ADMIN_PASS=

# Payments (Celo USDC) — required for credit accounts and deposits
# HD wallet seed phrase (stays on server, derives per-account deposit addresses)
WALLET_SEED=
# Treasury address deposits are swept to (separate key, not on server)
PAYMENT_RECIPIENT_ADDRESS=
# CELO_RPC_URL=https://forno.celo.org

# Optional: GitHub token for the github-api strategy (higher rate limits)
# GITHUB_TOKEN=
