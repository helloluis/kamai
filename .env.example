# Server
PORT=3100
HOST=0.0.0.0

# Browser
MAX_TEXT_LENGTH=30000
DEFAULT_TIMEOUT=15000

# Rate limiting
RATE_LIMIT_RPM=60

# Search — multiple providers with automatic failover (any missing provider
# just drops out of the chain). Get keys at serper.dev, brave.com/search/api,
# socialcrawl.dev, apify.com
SERPER_API_KEY=
BRAVE_API_KEY=
SOCIALCRAWL_API_KEY=
# Facebook public post search (apify.com — console.apify.com → Integrations → API tokens)
APIFY_API_TOKEN=
# Optional: override individual search actors
# APIFY_FB_SEARCH_ACTOR=
# APIFY_IG_SEARCH_ACTOR=
# APIFY_TT_SEARCH_ACTOR=
# APIFY_LI_SEARCH_ACTOR=

# Sister apps (comma-separated) — these API keys bypass payment entirely
SISTER_API_KEYS=

# Payments (Celo USDC) — required for credit accounts and deposits
# HD wallet seed phrase (stays on server, derives per-account deposit addresses)
WALLET_SEED=
# Treasury address deposits are swept to (separate key, not on server)
PAYMENT_RECIPIENT_ADDRESS=
# CELO_RPC_URL=https://forno.celo.org

# Optional: GitHub token for the github-api strategy (higher rate limits)
# GITHUB_TOKEN=
